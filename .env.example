AWS_REGION=us-east-1
# DynamoDB table for registrations, memberships and spot counters (unset = in-memory, dev only)
MARTIN_TABLE=martin-mx
SES_FROM_EMAIL=no-reply@martinmxpark.com
# Owner notifications (new members). Defaults to the park email; override in dev/test.
OWNER_NOTIFY_EMAIL=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Absolute origin for Stripe redirects; defaults to the request origin
SITE_URL=https://www.martinmxpark.com
